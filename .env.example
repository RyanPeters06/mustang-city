# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Public (sent to the browser) — restrict this token to your domains in Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Auth0 (@auth0/nextjs-auth0 v4)
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Tiger Data (Postgres + TimescaleDB)
DATABASE_URL=

# Gemini
GEMINI_API_KEY=

# Photo storage: Vercel Blob or Vultr Object Storage
BLOB_READ_WRITE_TOKEN=
VULTR_S3_ENDPOINT=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_BUCKET=
